{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teumsae-arcade",
  "account_id": "4754acbd9c9e5c93afd4a51a571813be",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcade",
      "database_id": "d3849237-3a48-4ea2-87e6-a3497709eabf",
      // 배포 전부터 쓰던 로컬 DB 식별자를 유지해 기존 로컬 기록을 보존한다.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
